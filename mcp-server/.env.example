# Firebase Configuration
FIREBASE_PROJECT_ID=pnl-amzon
FIREBASE_DATABASE_URL=https://pnl-amzon-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=pnl-amzon.firebasestorage.app

# Firebase Service Account Key Path
# Download your service account key from Firebase Console:
# Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# MCP Server Configuration
MCP_SERVER_NAME=pnl-management-server
MCP_SERVER_VERSION=1.0.0
